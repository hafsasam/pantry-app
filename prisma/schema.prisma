generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Ingredient {
  id               Int                @id @default(autoincrement())
  name             String             @unique
  pantryItem       PantryItem?
  recipeIngredients RecipeIngredient[]

  @@map("ingredients")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model PantryItem {
  id               Int        @id @default(autoincrement())
  ingredient_id    Int        @unique
  quantity         Decimal    @db.Decimal
  unit             String
  needs_restocking Boolean    @default(false)
  ingredient       Ingredient @relation(fields: [ingredient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("pantry_items")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model RecipeIngredient {
  id            Int        @id @default(autoincrement())
  ingredient_id Int
  recipe_id     Int
  quantity      Decimal    @db.Decimal
  unit          String
  ingredient    Ingredient @relation(fields: [ingredient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recipe        Recipe     @relation(fields: [recipe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([recipe_id, ingredient_id])
  @@index([ingredient_id])
  @@map("recipe_ingredients")
}

model RecipeStep {
  id        Int    @id @default(autoincrement())
  recipe_id Int
  position  Int
  text      String
  recipe    Recipe @relation(fields: [recipe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([recipe_id, position])
  @@map("recipe_steps")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Recipe {
  id                Int                @id @default(autoincrement())
  name              String
  prep_time_minutes Int?
  cook_time_minutes Int?
  recipeIngredients  RecipeIngredient[]
  recipeSteps        RecipeStep[]

  @@map("recipes")
}
